<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot Condition="'$(TargetFramework)' == 'net10.0-windows'">true</PublishAot>
    <BuiltInComInteropSupport Condition="'$(TargetFramework)' == 'net10.0-windows'">true</BuiltInComInteropSupport>
    <InvariantGlobalization Condition="'$(TargetFramework)' == 'net10.0-windows'">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\xidio.Core\xidio.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\xidio.Platform.Windows\xidio.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <ProjectReference Include="..\xidio.Platform.macOS\xidio.Platform.macOS.csproj" />
  </ItemGroup>

</Project>
